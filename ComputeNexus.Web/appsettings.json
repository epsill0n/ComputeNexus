{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=ComputeNexus.db;Cache=Shared"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharsLong!",
    "Issuer": "ComputeNexus",
    "Audience": "ComputeNexusUsers",
    "ExpiryMinutes": 60
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "FromAddress": "noreply@computenexus.com",
    "FromName": "ComputeNexus",
    "UseSsl": true
  },
  "ProviderApi": {
    "BaseAddress": "https://cloud.vast.ai/api/v0/bundles/",
    "ApiKey": "your_api_key",
    "TimeoutSeconds": 30,
    "CacheExpirationMinutes": 30
  }
}